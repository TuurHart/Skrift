# Local test fixtures (real recordings/notes/photos for manual -runfile + photo
# tests; kept out of git to avoid bloat — incl. the canonical "Hotel Du Vin.m4a"
# two-Jacks sample). Renamed from "test images - delete this folder" 2026-06-08.
# EXCEPT the synthetic corpus (2026-09-21): generated, small, and the v2 rewrite's change
# detector — it is versioned. `*` not `/` so the negation below can re-include a subfolder.
test-fixtures/*
!test-fixtures/corpus/

# Archived old apps (post-convergence move 2026-06) — re-ignore the build
# artifacts + personal config that the anchored root patterns above no longer
# match under archive/. (node_modules/ + .DS_Store are already non-anchored.)
archive/frontend-new/renderer-dist/
archive/frontend-new/dist-electron/
archive/frontend-new/*.tsbuildinfo
archive/frontend-new/vite.config.d.ts
archive/frontend-new/vite.config.js
archive/backend/data/
archive/backend/config/user_settings.json
archive/backend/config/names.json
archive/backend/resources/models/mlx/
